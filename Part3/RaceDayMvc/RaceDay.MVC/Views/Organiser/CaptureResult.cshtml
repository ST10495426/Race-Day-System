@{
    ViewData["Title"] = "Capture Result";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Capture Result</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CaptureResult" method="post">
                        <input type="hidden" name="enrolmentId" value="@ViewBag.EnrolmentID" />

                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select" required>
                                <option value="Completed">Completed</option>
                                <option value="DNF">Did Not Finish (DNF)</option>
                                <option value="DNS">Did Not Start (DNS)</option>
                                <option value="DQ">Disqualified (DQ)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Finish Time (HH:MM:SS)</label>
                            <input type="text" name="finishTime" class="form-control" placeholder="e.g. 02:15:30" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Position</label>
                            <input type="number" name="position" class="form-control" placeholder="e.g. 45" />
                        </div>

                        <button type="submit" class="btn btn-success w-100">Save Result</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
