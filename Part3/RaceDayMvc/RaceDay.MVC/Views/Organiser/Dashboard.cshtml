@model IEnumerable<RaceDay.Mvc.Models.EventListViewModel>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Organiser Dashboard</h2>
        <a asp-action="CreateEvent" class="btn btn-success">+ Create New Event</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">My Events</h5>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <p class="text-muted">You haven't created any events yet.</p>
            }
            else
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td>@ev.Name</td>
                                <td>@ev.Date.ToString("dd MMM yyyy")</td>
                                <td>@ev.Location</td>
                                <td>
                                    <a href="/Organiser/ManageCategories/@ev.EventID" class="btn btn-sm btn-primary">Manage Categories</a>
                                    <a href="/Organiser/ViewEnrolments/@ev.EventID" class="btn btn-sm btn-info text-white">View Enrolments</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
