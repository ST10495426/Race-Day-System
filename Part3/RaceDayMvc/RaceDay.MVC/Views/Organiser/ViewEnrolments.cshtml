@model List<Dictionary<string, object>>
@{
    ViewData["Title"] = "View Enrolments";
}

<div class="container mt-4">
    <h2>Enrolments (Event ID: @ViewBag.EventID)</h2>
    <a href="/Organiser/Dashboard" class="btn btn-secondary mb-3">Back to Dashboard</a>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">@ViewBag.Error</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model == null || Model.Count == 0)
            {
                <p class="text-muted">No one has enrolled in this event yet.</p>
            }
            else
            {
                <table class="table table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Participant Name</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item["participantName"]</td>
                                <td>@item["categoryName"]</td>
                                <td>
                                    @if (item["status"].ToString() == "Confirmed")
                                    {
                                        <span class="badge bg-success">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item["status"]</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Organiser/CaptureResult?enrolmentId=@item["enrolmentID"]" class="btn btn-sm btn-success">Capture Result</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
