@model IEnumerable<RaceDay.MVC.Models.EventListViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Upcoming Events</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No events found right now.</div>
    }
    else
    {
        <div class="row">
            @foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(ev.BannerUrl))
                        {
                            <img src="@ev.BannerUrl" class="card-img-top" alt="Event Banner" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 180px;">
                                <span>No Image</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@ev.Name</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@ev.EventTypeName - @ev.Distance</h6>
                            <p class="card-text text-truncate">@ev.Description</p>
                            
                            <ul class="list-unstyled small">
                                <li><strong>Date:</strong> @ev.Date.ToString("dd MMM yyyy")</li>
                                <li><strong>Location:</strong> @ev.Location</li>
                            </ul>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <a href="/Home/EventDetails/@ev.EventID" class="btn btn-primary w-100">View Event</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
