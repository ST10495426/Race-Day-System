@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">
    <h2>My Enrolments</h2>
    <p class="text-muted">Here are the events you have signed up for.</p>

    @if (ViewBag.Enrolments != null)
    {
        <div class="alert alert-success">
            You have enrolments! Data fetching worked.
        </div>
        <!-- We will format this properly in the next step -->
    }
    else
    {
        <div class="alert alert-warning">You haven't enrolled in any events yet.</div>
    }
</div>
