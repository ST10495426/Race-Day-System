@model List<Dictionary<string, object>>
@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">
    <h2>My Enrolments</h2>
    <p class="text-muted">Here are the events you have signed up for.</p>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">You haven't enrolled in any events yet.</div>
    }
    else
    {
        <table class="table table-striped shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Event Name</th>
                    <th>Category</th>
                    <th>Date Enrolled</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item["eventName"]</td>
                        <td>@item["categoryName"]</td>
                        <td>@DateTime.Parse(item["enrolmentDate"].ToString()).ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item["status"].ToString() == "Confirmed")
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                            else if (item["status"].ToString() == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@item["status"]</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
