@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2>My Results</h2>
    <p class="text-muted">Your personal race history.</p>

    @if (ViewBag.Results != null)
    {
        <div class="alert alert-success">
            Results loaded! Data fetching worked.
        </div>
        <!-- We will format this properly in the next step -->
    }
    else
    {
        <div class="alert alert-info">You don't have any results yet.</div>
    }
</div>
